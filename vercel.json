{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blank", "destination": "/impressum.html", "statusCode": 301 },
    { "source": "/blank-1", "destination": "/datenschutz.html", "statusCode": 301 },
    { "source": "/impressum", "destination": "/impressum.html", "statusCode": 301 },
    { "source": "/datenschutz", "destination": "/datenschutz.html", "statusCode": 301 },
    { "source": "/product-page/direct-flow-umkehrosmoseanlage", "destination": "/#produkte", "statusCode": 301 },
    { "source": "/product-page/direkt-flow-umkehrosmoseanlage-wifi-app", "destination": "/#produkte", "statusCode": 301 },
    { "source": "/category/all-products", "destination": "/#produkte", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}
      ]
    },
    {
      "source": "/assets/(images|videos|icons)/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=604800"}
      ]
    }
  ]
}